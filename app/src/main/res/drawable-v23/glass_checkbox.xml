<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass checkbox button (API 23+): rounded glass square with a white check
    mark centered when checked.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill_strong" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_border" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_check_white"
                android:gravity="center" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_field_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
