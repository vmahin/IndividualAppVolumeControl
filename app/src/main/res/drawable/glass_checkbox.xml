<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass checkbox button (API < 23 fallback: rounded glass square whose fill
    brightens when checked; no check glyph below v23, the fill change plus the
    row text keeps the state legible).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_field_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
