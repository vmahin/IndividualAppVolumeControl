<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass slider track: fully rounded translucent track with an accent-colored
    capsule that fills with the progress (tintable via progressTintList).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_track" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/app_primary" />
                <corners android:radius="100dp" />
            </shape>
        </clip>
    </item>
</layer-list>
