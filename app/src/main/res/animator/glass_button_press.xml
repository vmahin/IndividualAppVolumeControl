<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass button press animation: scale to 0.96 while pressed (quick, decelerating)
    and spring back to 1.0 on release (overshoot = "quick spring"), with a soft
    shadow that flattens on press. Uses stateListAnimator so no code touches it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="120"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="120"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="elevation"
                android:duration="120"
                android:valueTo="0.0"
                android:valueType="floatType" />
        </set>
    </item>

    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="90"
                android:valueTo="0.96"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="90"
                android:valueTo="0.96"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="elevation"
                android:duration="90"
                android:valueTo="0.0"
                android:valueType="floatType" />
        </set>
    </item>

    <item>
        <set android:interpolator="@android:interpolator/overshoot">
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="elevation"
                android:duration="160"
                android:valueTo="2.0"
                android:valueType="floatType" />
        </set>
    </item>

</selector>
